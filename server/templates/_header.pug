include _mixins

style.
  /* Enhanced Header Styles with Glow Effects */
  header:not(.landing-nav) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(15, 15, 35, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.75rem 1.5rem;
    z-index: 1000;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 100%;
  }
  header.scrolled:not(.landing-nav) {
    background: rgba(15, 15, 35, 0.98);
    backdrop-filter: blur(20px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  #logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  #logo img {
    height: 48px;
    width: auto;
  }
  #logo span {
    font-size: 1.6rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  header nav {
    margin-left: auto;
    margin-right: 3rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
    padding-right: 0;
  }
  header .nav-item {
    position: relative;
  }
  header .nav-link {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    padding: 0.4rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    border-radius: 8px;
  }
  header .nav-link:hover {
    color: #667eea;
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }
  
  /* Glow Hover Effect for Nav Links */
  header .nav-link.glow-hover {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  header .nav-link.glow-hover::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(102, 126, 234, 0.4), transparent);
    transform: translate(-50%, -50%);
    transition: width 0.5s, height 0.5s;
  }
  
  header .nav-link.glow-hover:hover::before {
    width: 300px;
    height: 300px;
  }
  
  header .nav-link.glow-hover:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
  }
  
  /* Gradient Styles for Different Nav Items */
  .gradient-dashboard span {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 600;
  }
  
  .gradient-search span {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 600;
  }
  
  .gradient-settings {
    transition: all 0.3s ease;
  }
  
  .gradient-settings:hover {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white !important;
  }
  
  .gradient-logout:hover {
    background: linear-gradient(135deg, #f5576c 0%, #ef4444 100%);
    color: white !important;
  }
  
  /* Enhanced User Button */
  #login-btn {
    position: relative;
    padding: 0.3rem 0.5rem;
    transition: all 0.3s ease;
  }
  
  #login-btn::after {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
    border-radius: 50%;
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
    filter: blur(8px);
  }
  
  #login-btn:hover::after {
    opacity: 0.6;
  }
  
  #login-btn:hover .nav-user-icon {
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
  }
  header .nav-text {
    display: inline-block;
  }
  header .nav-link.narrow .nav-text {
    display: none;
  }
  .nav-user-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: linear-gradient(white, white) padding-box,
                linear-gradient(135deg, #667eea, #764ba2) border-box;
    transition: all 0.3s ease;
  }
  
  /* Active state for nav links */
  header .nav-link.on {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.2), rgba(118, 75, 162, 0.2));
    box-shadow: 0 2px 10px rgba(102, 126, 234, 0.3);
  }
  
  /* Mobile optimizations */
  @media (max-width: 768px) {
    .nav-text {
      display: none;
    }
    
    header .nav-link {
      padding: 0.5rem;
    }
    
    header .nav-link x-icon {
      font-size: 20px;
    }
  }
  header .popup-body {
    background: rgba(15, 15, 35, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 0.5rem;
    min-width: 200px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
  header .popup-body .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    width: 100%;
    border-radius: 8px;
    transition: all 0.2s;
  }
  header .popup-body .nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }
  .btn-row.social {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .btn-row.social .btn {
    flex: 1;
    padding: 10px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    color: white;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s;
    text-align: center;
  }
  .btn-row.social .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
  }
  #language .modal-body, #login .modal-body {
    background: rgba(15, 15, 35, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2rem;
    max-width: 600px;
    margin: 0 auto;
    width: 90%;
  }
  
  #search .modal-body {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    max-width: 700px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  #search .form-field {
    width: 100%;
    max-width: 400px;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 25px;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0;
    height: 45px;
    position: relative;
    overflow: hidden;
  }
  
  #search .form-field input {
    background: transparent;
    border: none;
    outline: none;
    color: white;
    flex: 1;
    font-size: 1rem;
    padding: 0 1rem 0 3rem;
    height: 100%;
    width: 100%;
  }
  
  #search .form-field input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  
  #search .form-field x-icon {
    position: absolute;
    left: 1rem;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }
  
  #search .search-body {
    width: 100%;
    max-width: 700px;
    overflow-y: auto;
    max-height: 60vh;
    padding: 0 1rem;
  }
  body.has-header {
    padding-top: 80px;
  }
  
  @media (max-width: 768px) {
    header:not(.landing-nav) {
      padding: 0.5rem 1rem;
    }
    header nav {
      gap: 0.3rem;
      margin-right: 1rem;
      padding-right: 0;
    }
    header .nav-link {
      padding: 0.3rem 0.4rem;
      font-size: 0.9rem;
    }
    #logo img {
      height: 40px;
    }
    #logo span {
      font-size: 1.4rem;
    }
  }

header
  block logo
    a#logo(href=(user ? '/dashboard' : '/') title=config.siteName)
      img(src="/images/logokb.png" alt="Kha-Boom!")
      span Kha-Boom!

  //- Accessibility Button
  button#skip-nav= __("Skip Navigation")

  nav
    for link in config.header.links
      .nav-item
        a.nav-link.glow-hover(href=link.url)
          x-icon(name=link.icon)
          span.nav-text= __(link.title)
    
    //- Dashboard Link (only for logged in users)
    if user
      .nav-item
        a.nav-link.glow-hover.gradient-dashboard(href='/dashboard' class=(url && url.startsWith('/dashboard') ? 'on' : ''))
          x-icon(name='dashboard')
          span.nav-text Dashboard

    //- Smart Search
    if config.search.enabled && locale.id === 'en'
      .nav-item
        button.nav-link.glow-hover.gradient-search(title=__('Smart Search') data-modal="search")
          x-icon(name="search")
          span.nav-text Smart Search

    x-popup(animation="fade").nav-item
      block nav-user-btn
        button.nav-link.narrow.popup-target#login-btn
          if user
            img.nav-user-icon.nav-large(src=user.avatar(56) alt=__('User'))
          else
            x-icon.nav-large(name="user")

      .popup-body
        block nav-user-body
          if config.accounts.enabled
            if user
              a.nav-link.gradient-settings(href="/profile") 
                x-icon(name='settings')
                | #{__('Account Settings')}
            else
              button.nav-link(data-modal="login") 
                x-icon(name="login")
                | #{__('Sign in')}
              a.nav-link(href="/signup") 
                x-icon(name='user')
                | #{__('Create New Account')}
          if availableLocales.length > 1
            button.nav-link(data-modal="language")
              x-icon(name="language")
              | #{__('Change Language')}
              img(src=`/images/flags/${locale.flag}.png` width=24 height=24 alt="")
          if user
            a.nav-link.gradient-logout(href="/logout") 
              x-icon(name='logout')
              | #{__('Sign out')}

if config.search.enabled && locale.id === 'en'
  x-modal#search(class=(req.query.search ? 'open' : undefined))
    .modal-body
      .form-field
        x-icon(name="search" size=20)
        input(type="text" placeholder=__("Search…") inputmode="search" autocomplete="off" maxlength=50 value=(req.query.search || req.cookies.search || ''))
      .search-body
        include ./search

if availableLocales.length > 1
  +modal('language')
    h2.text-center #[x-icon(name="language" size=32)] #{__('Change Language')}
    .locale-list
      for l in availableLocales
        // TODO Use /hl=de rather than subdomains when running on localhost!
        a.locale-link(href=`https://${l.id === 'en' ? '' : l.id + '.'}${config.domain}${req.path}`)
          img(src=`/images/flags/${l.flag}.png` width=36 height=36 alt="")
          | #{l.name}

if !user && config.accounts.enabled
  +modal('login')
    h2 #[x-icon(name="user" size=32)] #{__('Sign in to $0', config.siteName)}

    if oAuthProviders.length
      .btn-row.social
        for p in oAuthProviders
          a.btn(href=`/auth/${p.id}` class=p.id) #[x-icon(name=p.id)] #{p.name}
      .hr: span= __('or')

    form(method="POST" action="/login")
      input(type="hidden" name="_csrf" value=_csrf)

      label.form-field
        input(type="email" name="email" placeholder=__('Email') required autocomplete="email")
        span.placeholder #{__('Email')}

      label.form-field
        input#password.form-field(type="password" name="password" placeholder=__('Password') minlength="4" required autocomplete="password")
        span.placeholder #{__('Password')}

      p.btn-row
        a(href='/signup') #{__('New Account')}
        | &nbsp; &nbsp; &nbsp;
        a(href='/forgot') #{__('Reset Password')}
        | &nbsp; &nbsp; &nbsp;
        button.btn.btn-red(type="submit") #{__('Sign in')}
