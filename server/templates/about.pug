doctype html
html(lang="en" theme=theme)
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title About - Kha-Boom!
    meta(name="description" content="Learn about Kha-Boom! and our mission to revolutionize online education")
    
    // Google Fonts
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    
    // Main styles
    link(href=cacheBust('/main.css') rel='stylesheet')
    
    style.
      * {
        scroll-behavior: smooth;
      }
      
      .about-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        padding: 1rem 2rem;
        background: rgba(15, 15, 35, 0.95);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
      }
      
      .about-nav.scrolled {
        background: rgba(5, 5, 15, 0.98);
        backdrop-filter: blur(20px);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
      }
      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .about-hero {
        padding: 8rem 2rem 4rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .mission-section {
        padding: 4rem 2rem;
        max-width: 1000px;
        margin: 0 auto;
      }
      .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        max-width: 1000px;
        margin: 0 auto;
      }
      .team-card {
        text-align: center;
        padding: 2rem;
      }
      .team-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
      }
      .values-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 3rem auto;
      }
      .value-card {
        padding: 2rem;
        text-align: left;
      }
      .value-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }
      .timeline {
        position: relative;
        max-width: 800px;
        margin: 3rem auto;
        padding: 0 2rem;
      }
      .timeline::before {
        content: '';
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 100%;
        background: linear-gradient(180deg, #667eea, #764ba2);
      }
      .timeline-item {
        position: relative;
        padding: 2rem;
        margin: 2rem 0;
        width: calc(50% - 2rem);
      }
      .timeline-item:nth-child(odd) {
        left: 0;
        text-align: right;
      }
      .timeline-item:nth-child(even) {
        left: calc(50% + 2rem);
        text-align: left;
      }
      .timeline-dot {
        position: absolute;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        top: 2rem;
      }
      .timeline-item:nth-child(odd) .timeline-dot {
        right: -2.5rem;
      }
      .timeline-item:nth-child(even) .timeline-dot {
        left: -2.5rem;
      }
      @media (max-width: 768px) {
        .timeline::before {
          left: 2rem;
        }
        .timeline-item {
          width: calc(100% - 4rem);
          left: 4rem !important;
          text-align: left !important;
        }
        .timeline-dot {
          left: -2.5rem !important;
        }
      }
      .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      .nav-link {
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        transition: width 0.3s ease;
      }
      .nav-link:hover::after, .nav-link.active::after {
        width: 100%;
      }
      .logo-container {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .logo-text {
        font-size: 1.8rem;
        font-weight: 700;
      }
      
      // Artistic section styles with scroll animations
      .about-section {
        padding: 8rem 2rem;
        max-width: 1600px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
      }
      
      
      .about-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 4rem;
        align-items: center;
        min-height: 800px;
        position: relative;
        z-index: 2;
        width: 100%;
      }
      
      .about-content {
        padding: 3rem 0 3rem 2rem;
        position: relative;
        opacity: 0;
        transform: translateX(-100px);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-content.animate {
        opacity: 1;
        transform: translateX(0);
      }
      
      .about-content.story-content::before {
        content: '';
        position: absolute;
        left: -4rem;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #667eea, #764ba2);
        border-radius: 2px;
        opacity: 0.6;
      }
      
      .about-content.story-content {
        padding: 3rem 0 3rem 2rem;
      }
      
      .about-content.approach-content::before {
        content: '';
        position: absolute;
        right: -4rem;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #667eea, #764ba2);
        border-radius: 2px;
        opacity: 0.6;
      }
      
      .about-content.approach-content {
        padding: 3rem 2rem 3rem 0;
      }
      
      .about-content h2 {
        font-size: 3.5rem;
        margin-bottom: 3rem;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.02em;
        position: relative;
        background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
      }
      
      .about-content h2::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 2px;
      }
      
      .about-content p {
        font-size: 1.4rem;
        line-height: 1.9;
        margin-bottom: 2.5rem;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 400;
        position: relative;
        padding-left: 1rem;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-content p.animate {
        opacity: 1;
        transform: translateY(0);
      }
      
      .about-content p::before {
        content: '✦';
        position: absolute;
        left: -1rem;
        top: 0.5rem;
        color: #667eea;
        font-size: 1rem;
        opacity: 0.7;
      }
      
      .about-image.story-image {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3),
                    0 0 0 1px rgba(255, 255, 255, 0.1);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d;
        opacity: 0;
        transform: translateX(-100px) rotateY(-15deg);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-image.story-image.animate {
        opacity: 1;
        transform: translateX(0) rotateY(0deg);
      }
      
      .about-image.story-image:hover {
        transform: translateY(-20px) rotateX(5deg) rotateY(-5deg);
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4),
                    0 0 0 1px rgba(255, 255, 255, 0.2);
      }
      
      .about-image.story-image {
        width: 100%;
        height: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.1);
        border-radius: 30px;
        overflow: hidden;
        padding: 0;
        margin: 0;
        margin-top: 12rem;
      }
      
      .about-image.story-image img {
        width: 100% !important;
        height: auto !important;
        max-height: 900px !important;
        object-fit: contain !important;
        object-position: center center !important;
        border-radius: 0 !important;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        filter: brightness(1.1) contrast(1.1);
        display: block;
      }
      
      .about-image.story-image:hover img {
        transform: scale(1.08);
        filter: brightness(1.2) contrast(1.2) saturate(1.1);
      }
      
      .about-image.approach-image {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3),
                    0 0 0 1px rgba(255, 255, 255, 0.1);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d;
        opacity: 0;
        transform: translateX(100px) rotateY(15deg);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-image.approach-image.animate {
        opacity: 1;
        transform: translateX(0) rotateY(0deg);
      }
      
      .about-image.approach-image:hover {
        transform: translateY(-20px) rotateX(5deg) rotateY(5deg);
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4),
                    0 0 0 1px rgba(255, 255, 255, 0.2);
      }
      
      .about-image.approach-image {
        margin-top: 12rem;
      }
      
      .about-image.approach-image img {
        width: 100% !important;
        height: 900px !important;
        object-fit: cover !important;
        border-radius: 30px !important;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        filter: brightness(1.1) contrast(1.1);
        object-position: left center;
      }
      
      .about-image.approach-image:hover img {
        animation: panImage 4s ease-in-out infinite;
        filter: brightness(1.2) contrast(1.2) saturate(1.1);
      }
      
      @keyframes panImage {
        0% {
          object-position: left center;
        }
        25% {
          object-position: center center;
        }
        50% {
          object-position: right center;
        }
        75% {
          object-position: center center;
        }
        100% {
          object-position: left center;
        }
      }
      
      .team-section {
        padding: 6rem 2rem;
        background: linear-gradient(135deg, 
                    rgba(102, 126, 234, 0.15) 0%, 
                    rgba(118, 75, 162, 0.15) 50%,
                    rgba(240, 147, 251, 0.15) 100%);
        backdrop-filter: blur(20px);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
      }
      
      
      .team-header {
        text-align: center;
        margin-bottom: 5rem;
        position: relative;
        z-index: 3;
        opacity: 0;
        transform: translateY(50px);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .team-header.animate {
        opacity: 1;
        transform: translateY(0);
      }
      
      .team-header h2 {
        font-size: 3.5rem;
        margin-bottom: 2rem;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.02em;
        position: relative;
        background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
      }
      
      .team-header h2::before {
        content: '';
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 2px;
      }
      
      .team-header h2::after {
        content: '';
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #764ba2, #667eea);
        border-radius: 2px;
      }
      
      .team-header p {
        font-size: 1.4rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 700px;
        margin: 0 auto;
        font-weight: 400;
        line-height: 1.6;
      }
      
      .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 4rem;
        max-width: 1600px;
        margin: 0 auto;
        position: relative;
        z-index: 3;
      }
      
      .team-member {
        background: linear-gradient(135deg, 
                    rgba(255, 255, 255, 0.1) 0%, 
                    rgba(255, 255, 255, 0.05) 100%);
        border-radius: 24px;
        padding: 2.5rem;
        text-align: center;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        position: relative;
        overflow: visible;
        opacity: 0;
        transform: translateY(30px);
        cursor: pointer;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        min-height: 320px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
      }
      
      .team-member.animate {
        opacity: 1;
        transform: translateY(0);
      }
      
      .team-member::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, 
                    rgba(102, 126, 234, 0.1) 0%, 
                    rgba(118, 75, 162, 0.1) 50%,
                    rgba(240, 147, 251, 0.1) 100%);
        opacity: 0;
        transition: opacity 0.4s ease;
        border-radius: 24px;
        z-index: 1;
      }
      
      .team-member:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15),
                    0 0 0 1px rgba(102, 126, 234, 0.3);
        border-color: rgba(102, 126, 234, 0.4);
      }
      
      .team-member:hover::before {
        opacity: 1;
      }
      
      .crown-icon {
        position: absolute;
        top: -30px;
        left: 50%;
        transform: translateX(-50%) translateY(-20px);
        font-size: 5rem;
        opacity: 0;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 99999;
        pointer-events: none;
        filter: drop-shadow(0 0 25px rgba(255, 215, 0, 0.9));
      }
      
      .team-member:hover .crown-icon {
        opacity: 1;
        animation: crownFloat 2s ease-in-out infinite;
      }
      
      @keyframes crownFloat {
        0%, 100% {
          transform: translateX(-50%) translateY(-20px) rotate(-5deg);
        }
        50% {
          transform: translateX(-50%) translateY(-35px) rotate(5deg);
        }
      }
      
      
      .team-member.animate {
        opacity: 1;
        transform: translateY(0);
      }
      
      .team-member:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        border-color: rgba(255, 255, 255, 0.2);
      }
      
      .team-member.popup-active {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.1);
        width: 90vw;
        height: 90vh;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 20px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        animation: popupExplode 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
        overflow: visible;
      }
      
      .team-member.popup-active .member-image {
        width: 300px;
        height: 300px;
        border-radius: 20px;
        margin: 2rem auto;
        border: 8px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
        animation: imageFloat 2s ease-in-out infinite;
      }
      
      .team-member.popup-active .member-content {
        padding: 2rem;
        color: white;
      }
      
      .team-member.popup-active .member-content h3 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
      }
      
      .team-member.popup-active .member-content .role {
        font-size: 1.5rem;
        color: #667eea;
        margin-bottom: 2rem;
      }
      
      .team-member.popup-active .member-content .bio {
        font-size: 1.2rem;
        line-height: 1.8;
        opacity: 0.9;
        max-width: 600px;
        margin: 0 auto;
      }
      
      .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        z-index: 9998;
        opacity: 0;
        animation: fadeIn 0.3s ease forwards;
      }
      
      .explosion-particles {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 10000;
      }
      
      .particle {
        position: absolute;
        width: 8px;
        height: 8px;
        background: linear-gradient(45deg, #667eea, #764ba2);
        border-radius: 50%;
        animation: particleExplode 1.5s ease-out forwards;
      }
      
      .particle:nth-child(1) { animation-delay: 0.1s; }
      .particle:nth-child(2) { animation-delay: 0.2s; }
      .particle:nth-child(3) { animation-delay: 0.3s; }
      .particle:nth-child(4) { animation-delay: 0.4s; }
      .particle:nth-child(5) { animation-delay: 0.5s; }
      .particle:nth-child(6) { animation-delay: 0.6s; }
      .particle:nth-child(7) { animation-delay: 0.7s; }
      .particle:nth-child(8) { animation-delay: 0.8s; }
      
      .close-popup {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        color: white;
        font-size: 24px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        z-index: 10001;
      }
      
      .close-popup:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: scale(1.1);
      }
      
      @keyframes popupExplode {
        0% {
          transform: translate(-50%, -50%) scale(0.1);
          opacity: 0;
        }
        50% {
          transform: translate(-50%, -50%) scale(1.1);
          opacity: 1;
        }
        100% {
          transform: translate(-50%, -50%) scale(1);
          opacity: 1;
        }
      }
      
      @keyframes imageFloat {
        0%, 100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-10px);
        }
      }
      
      @keyframes particleExplode {
        0% {
          transform: translate(-50%, -50%) scale(0);
          opacity: 1;
        }
        100% {
          transform: translate(-50%, -50%) scale(1) translate(var(--dx, 200px), var(--dy, -200px));
          opacity: 0;
        }
      }
      
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      
      .member-image {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        margin: 0 auto 1.5rem;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        border: 3px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        position: relative;
        z-index: 10;
        overflow: hidden;
      }
      
      .member-image::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, 
                    rgba(102, 126, 234, 0.2) 0%, 
                    rgba(118, 75, 162, 0.2) 100%);
        opacity: 0;
        transition: opacity 0.4s ease;
        border-radius: 50%;
      }
      
      .team-member:hover .member-image {
        transform: scale(1.05);
        border-color: rgba(102, 126, 234, 0.6);
        box-shadow: 0 12px 48px rgba(102, 126, 234, 0.25);
      }
      
      .team-member:hover .member-image::before {
        opacity: 1;
      }
      
      .member-content {
        position: relative;
        z-index: 10;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      
      .member-content h3 {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
        transition: all 0.4s ease;
        line-height: 1.2;
      }
      
      .team-member:hover .member-content h3 {
        transform: translateY(-2px);
      }
      
      .member-content .role {
        font-size: 1rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 1rem;
        transition: all 0.4s ease;
      }
      
      .team-member:hover .member-content .role {
        color: #ff6b6b;
        transform: translateY(-1px);
        text-shadow: 0 0 10px rgba(255, 107, 107, 0.5);
      }
      
      
      
