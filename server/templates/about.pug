doctype html
html(lang="en" theme=theme)
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title About - Kha-Boom!
    meta(name="description" content="Learn about Kha-Boom! and our mission to revolutionize online education")
    
    // Google Fonts
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    
    // Main styles
    link(href=cacheBust('/main.css') rel='stylesheet')
    
    style.
      * {
        scroll-behavior: smooth;
      }
      
      .about-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        padding: 1rem 2rem;
        background: rgba(15, 15, 35, 0.95);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
      }
      
      .about-nav.scrolled {
        background: rgba(5, 5, 15, 0.98);
        backdrop-filter: blur(20px);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
      }
      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .about-hero {
        padding: 8rem 2rem 4rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .mission-section {
        padding: 4rem 2rem;
        max-width: 1000px;
        margin: 0 auto;
      }
      .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        max-width: 1000px;
        margin: 0 auto;
      }
      .team-card {
        text-align: center;
        padding: 2rem;
      }
      .team-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
      }
      .values-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 3rem auto;
      }
      .value-card {
        padding: 2rem;
        text-align: left;
      }
      .value-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }
      .timeline {
        position: relative;
        max-width: 800px;
        margin: 3rem auto;
        padding: 0 2rem;
      }
      .timeline::before {
        content: '';
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 100%;
        background: linear-gradient(180deg, #667eea, #764ba2);
      }
      .timeline-item {
        position: relative;
        padding: 2rem;
        margin: 2rem 0;
        width: calc(50% - 2rem);
      }
      .timeline-item:nth-child(odd) {
        left: 0;
        text-align: right;
      }
      .timeline-item:nth-child(even) {
        left: calc(50% + 2rem);
        text-align: left;
      }
      .timeline-dot {
        position: absolute;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        top: 2rem;
      }
      .timeline-item:nth-child(odd) .timeline-dot {
        right: -2.5rem;
      }
      .timeline-item:nth-child(even) .timeline-dot {
        left: -2.5rem;
      }
      @media (max-width: 768px) {
        .timeline::before {
          left: 2rem;
        }
        .timeline-item {
          width: calc(100% - 4rem);
          left: 4rem !important;
          text-align: left !important;
        }
        .timeline-dot {
          left: -2.5rem !important;
        }
      }
      .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      .nav-link {
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        transition: width 0.3s ease;
      }
      .nav-link:hover::after, .nav-link.active::after {
        width: 100%;
      }
      .logo-container {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .logo-text {
        font-size: 1.8rem;
        font-weight: 700;
      }
      
      // Artistic section styles with scroll animations
      .about-section {
        padding: 8rem 2rem;
        max-width: 1600px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
      }
      
      
      .about-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 4rem;
        align-items: center;
        min-height: 800px;
        position: relative;
        z-index: 2;
        width: 100%;
      }
      
      .about-content {
        padding: 3rem 0 3rem 2rem;
        position: relative;
        opacity: 0;
        transform: translateX(-100px);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-content.animate {
        opacity: 1;
        transform: translateX(0);
      }
      
      .about-content.story-content::before {
        content: '';
        position: absolute;
        left: -4rem;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #667eea, #764ba2);
        border-radius: 2px;
        opacity: 0.6;
      }
      
      .about-content.story-content {
        padding: 3rem 0 3rem 2rem;
      }
      
      .about-content.approach-content::before {
        content: '';
        position: absolute;
        right: -4rem;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #667eea, #764ba2);
        border-radius: 2px;
        opacity: 0.6;
      }
      
      .about-content.approach-content {
        padding: 3rem 2rem 3rem 0;
      }
      
      .about-content h2 {
        font-size: 3.5rem;
        margin-bottom: 3rem;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.02em;
        position: relative;
        background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
      }
      
      .about-content h2::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 2px;
      }
      
      .about-content p {
        font-size: 1.4rem;
        line-height: 1.9;
        margin-bottom: 2.5rem;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 400;
        position: relative;
        padding-left: 1rem;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-content p.animate {
        opacity: 1;
        transform: translateY(0);
      }
      
      .about-content p::before {
        content: '✦';
        position: absolute;
        left: -1rem;
        top: 0.5rem;
        color: #667eea;
        font-size: 1rem;
        opacity: 0.7;
      }
      
      .about-image.story-image {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3),
                    0 0 0 1px rgba(255, 255, 255, 0.1);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d;
        opacity: 0;
        transform: translateX(-100px) rotateY(-15deg);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-image.story-image.animate {
        opacity: 1;
        transform: translateX(0) rotateY(0deg);
      }
      
      .about-image.story-image:hover {
        transform: translateY(-20px) rotateX(5deg) rotateY(-5deg);
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4),
                    0 0 0 1px rgba(255, 255, 255, 0.2);
      }
      
      .about-image.story-image {
        width: 100%;
        height: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.1);
        border-radius: 30px;
        overflow: hidden;
        padding: 0;
        margin: 0;
        margin-top: 12rem;
      }
      
      .about-image.story-image img {
        width: 100% !important;
        height: auto !important;
        max-height: 900px !important;
        object-fit: contain !important;
        object-position: center center !important;
        border-radius: 0 !important;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        filter: brightness(1.1) contrast(1.1);
        display: block;
      }
      
      .about-image.story-image:hover img {
        transform: scale(1.08);
        filter: brightness(1.2) contrast(1.2) saturate(1.1);
      }
      
      .about-image.approach-image {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3),
                    0 0 0 1px rgba(255, 255, 255, 0.1);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d;
        opacity: 0;
        transform: translateX(100px) rotateY(15deg);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .about-image.approach-image.animate {
        opacity: 1;
        transform: translateX(0) rotateY(0deg);
      }
      
      .about-image.approach-image:hover {
        transform: translateY(-20px) rotateX(5deg) rotateY(5deg);
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4),
                    0 0 0 1px rgba(255, 255, 255, 0.2);
      }
      
      .about-image.approach-image {
        margin-top: 12rem;
      }
      
      .about-image.approach-image img {
        width: 100% !important;
        height: 900px !important;
        object-fit: cover !important;
        border-radius: 30px !important;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        filter: brightness(1.1) contrast(1.1);
        object-position: left center;
      }
      
      .about-image.approach-image:hover img {
        animation: panImage 4s ease-in-out infinite;
        filter: brightness(1.2) contrast(1.2) saturate(1.1);
      }
      
      @keyframes panImage {
        0% {
          object-position: left center;
        }
        25% {
          object-position: center center;
        }
        50% {
          object-position: right center;
        }
        75% {
          object-position: center center;
        }
        100% {
          object-position: left center;
        }
      }
      
      .team-section {
        padding: 6rem 2rem;
        background: linear-gradient(135deg, 
                    rgba(102, 126, 234, 0.15) 0%, 
                    rgba(118, 75, 162, 0.15) 50%,
                    rgba(240, 147, 251, 0.15) 100%);
        backdrop-filter: blur(20px);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
      }
      
      
      .team-header {
        text-align: center;
        margin-bottom: 5rem;
        position: relative;
        z-index: 3;
        opacity: 0;
        transform: translateY(50px);
        transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .team-header.animate {
        opacity: 1;
        transform: translateY(0);
      }
      
      .team-header h2 {
        font-size: 3.5rem;
        margin-bottom: 2rem;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.02em;
        position: relative;
        background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
      }
      
      .team-header h2::before {
        content: '';
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 2px;
      }
      
      .team-header h2::after {
        content: '';
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #764ba2, #667eea);
        border-radius: 2px;
      }
      
      .team-header p {
        font-size: 1.4rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 700px;
        margin: 0 auto;
        font-weight: 400;
        line-height: 1.6;
      }
      
      /* Instructor Section - Special Styling */
      .instructor-section {
        max-width: 1200px;
        margin: 0 auto 5rem;
        position: relative;
        z-index: 10;
      }
      
      .instructor-card {
        background: linear-gradient(135deg, 
                    rgba(30, 30, 50, 0.95) 0%, 
                    rgba(20, 20, 40, 0.98) 100%);
        border-radius: 40px;
        padding: 4rem;
        display: flex;
        gap: 4rem;
        align-items: center;
        backdrop-filter: blur(40px);
        border: 3px solid transparent;
        background-image: linear-gradient(135deg, rgba(30, 30, 50, 0.95), rgba(20, 20, 40, 0.98)),
                          linear-gradient(135deg, #FFD700, #FFA500, #FF6B35, #FFD700);
        background-origin: border-box;
        background-clip: padding-box, border-box;
        position: relative;
        overflow: visible;
        transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5),
                    0 0 0 1px rgba(255, 215, 0, 0.1);
      }
      
      .instructor-card::before {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 40px;
        padding: 3px;
        background: linear-gradient(135deg, #FFD700, #FFA500, #FF6B35, #FFD700);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.6s ease;
        animation: borderGradient 3s ease-in-out infinite;
      }
      
      @keyframes borderGradient {
        0%, 100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }
      
      .instructor-card:hover::before {
        opacity: 1;
      }
      
      .instructor-card::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at center, 
                    rgba(255, 215, 0, 0.15) 0%, 
                    transparent 50%);
        opacity: 0;
        transition: opacity 0.6s ease;
        pointer-events: none;
        animation: pulseGlow 4s ease-in-out infinite;
      }
      
      @keyframes pulseGlow {
        0%, 100% {
          transform: scale(0.8);
          opacity: 0.3;
        }
        50% {
          transform: scale(1.2);
          opacity: 0.6;
        }
      }
      
      .instructor-card:hover::after {
        opacity: 1;
      }
      
      .instructor-card:hover {
        transform: translateY(-20px) scale(1.03);
        box-shadow: 0 40px 120px rgba(255, 215, 0, 0.4),
                    0 0 100px rgba(255, 165, 0, 0.3),
                    0 0 0 1px rgba(255, 215, 0, 0.5);
      }
      
      .instructor-image-wrapper {
        position: relative;
        flex-shrink: 0;
      }
      
      .instructor-image {
        width: 380px;
        height: 380px;
        border-radius: 30px;
        background-size: cover;
        background-position: center;
        position: relative;
        z-index: 2;
        transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
        border: 4px solid transparent;
        background-image: linear-gradient(white, white),
                          linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
        background-origin: border-box;
        background-clip: padding-box, border-box;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4),
                    0 0 40px rgba(255, 215, 0, 0.2);
      }
      
      .instructor-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, 
                    rgba(255, 215, 0, 0.6) 0%, 
                    rgba(255, 165, 0, 0.4) 30%,
                    rgba(255, 107, 53, 0.2) 60%,
                    transparent 80%);
        border-radius: 50%;
        opacity: 0;
        transition: opacity 0.8s ease;
        z-index: 1;
        filter: blur(30px);
      }
      
      .instructor-card:hover .instructor-glow {
        opacity: 1;
        animation: glowPulse 2s ease-in-out infinite;
      }
      
      .instructor-card:hover .instructor-image {
        transform: scale(1.15) translateY(-15px) rotate(-2deg);
        box-shadow: 0 35px 120px rgba(255, 215, 0, 0.8),
                    0 0 100px rgba(255, 165, 0, 0.7),
                    0 0 150px rgba(255, 107, 53, 0.5),
                    inset 0 0 80px rgba(255, 215, 0, 0.3);
        animation: imageShake 0.5s ease-in-out infinite;
      }
      
      @keyframes imageShake {
        0%, 100% {
          transform: scale(1.15) translateY(-15px) rotate(-2deg);
        }
        25% {
          transform: scale(1.16) translateY(-16px) rotate(-3deg);
        }
        50% {
          transform: scale(1.15) translateY(-15px) rotate(-2deg);
        }
        75% {
          transform: scale(1.16) translateY(-16px) rotate(-1deg);
        }
      }
      
      @keyframes glowPulse {
        0%, 100% {
          transform: translate(-50%, -50%) scale(1);
          opacity: 0.8;
        }
        50% {
          transform: translate(-50%, -50%) scale(1.15);
          opacity: 1;
        }
      }
      
      .instructor-content {
        flex: 1;
        position: relative;
        z-index: 2;
        text-align: center;
      }
      
      .instructor-badge {
        display: inline-block;
        padding: 0.7rem 2rem;
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
        color: #000;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: 800;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        box-shadow: 0 8px 25px rgba(255, 215, 0, 0.5),
                    0 0 30px rgba(255, 165, 0, 0.3);
        animation: badgeFloat 3s ease-in-out infinite;
        position: relative;
        overflow: hidden;
      }
      
      .instructor-badge::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.5), transparent);
        transform: rotate(45deg);
        animation: badgeShine 3s ease-in-out infinite;
      }
      
      @keyframes badgeFloat {
        0%, 100% {
          transform: translateY(0px) scale(1);
        }
        50% {
          transform: translateY(-8px) scale(1.05);
        }
      }
      
      @keyframes badgeShine {
        0% {
          left: -200%;
        }
        50%, 100% {
          left: 200%;
        }
      }
      
      .instructor-name {
        font-size: 3.5rem;
        font-weight: 900;
        margin-bottom: 0.8rem;
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 30%, #FF6B35 60%, #FFA500 100%);
        background-size: 300% 300%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 4s ease-in-out infinite;
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        filter: drop-shadow(0 0 30px rgba(255, 215, 0, 0.6));
        position: relative;
        text-align: center;
        line-height: 1.2;
      }
      
      .instructor-name::before {
        content: '✨';
        position: absolute;
        left: -60px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 2.5rem;
        opacity: 0;
        transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      
      .instructor-name::after {
        content: '✨';
        position: absolute;
        right: -60px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 2.5rem;
        opacity: 0;
        transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      
      .instructor-card:hover .instructor-name {
        transform: scale(1.15);
        letter-spacing: 3px;
        filter: drop-shadow(0 0 50px rgba(255, 215, 0, 1)) 
                drop-shadow(0 0 80px rgba(255, 165, 0, 0.8));
      }
      
      .instructor-card:hover .instructor-name::before {
        opacity: 1;
        left: -80px;
        animation: sparkleRotateLeft 1.5s ease-in-out infinite;
      }
      
      .instructor-card:hover .instructor-name::after {
        opacity: 1;
        right: -80px;
        animation: sparkleRotateRight 1.5s ease-in-out infinite;
      }
      
      @keyframes sparkleRotateLeft {
        0%, 100% {
          transform: translateY(-50%) rotate(0deg) scale(1);
        }
        50% {
          transform: translateY(-50%) rotate(-25deg) scale(1.4);
        }
      }
      
      @keyframes sparkleRotateRight {
        0%, 100% {
          transform: translateY(-50%) rotate(0deg) scale(1);
        }
        50% {
          transform: translateY(-50%) rotate(25deg) scale(1.4);
        }
      }
      
      .instructor-title {
        font-size: 1.5rem;
        color: rgba(255, 215, 0, 0.95);
        margin-bottom: 0.5rem;
        font-weight: 700;
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        text-transform: uppercase;
        letter-spacing: 1px;
        text-align: center;
      }
      
      .instructor-card:hover .instructor-title {
        transform: scale(1.1);
        color: #FFD700;
        text-shadow: 0 0 30px rgba(255, 215, 0, 0.8),
                     0 0 60px rgba(255, 165, 0, 0.6);
      }
      
      .instructor-desc {
