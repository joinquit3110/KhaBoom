    script(src=cacheBust('/main.js'))
    script.
      // Profile dropdown toggle
      function toggleProfileDropdown() {
        const dropdown = document.getElementById('profileDropdown');
        dropdown.classList.toggle('active');
      }
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('profileDropdown');
        const profileContainer = document.querySelector('.profile-container');
        if (dropdown && profileContainer && !profileContainer.contains(event.target)) {
          dropdown.classList.remove('active');
        }
      });
      
      // Scroll animations and effects
      let ticking = false;
      
      function updateScrollEffects() {
        const scrolled = window.pageYOffset;
        const nav = document.querySelector('.about-nav');
        
        // Navbar scroll effect
        if (scrolled > 100) {
          nav.classList.add('scrolled');
        } else {
          nav.classList.remove('scrolled');
        }
        
        // Scroll-triggered animations
        const animatedElements = document.querySelectorAll('.about-content, .about-image, .team-header, .team-member');
        
        animatedElements.forEach((element, index) => {
          const elementTop = element.getBoundingClientRect().top;
          const elementVisible = 150;
          
          if (elementTop < window.innerHeight - elementVisible) {
            setTimeout(() => {
              element.classList.add('animate');
              
              // Animate paragraphs with delay
              if (element.classList.contains('about-content')) {
                const paragraphs = element.querySelectorAll('p');
                paragraphs.forEach((p, pIndex) => {
                  setTimeout(() => {
                    p.classList.add('animate');
                  }, pIndex * 200);
                });
              }
            }, index * 100);
          }
        });
        
        ticking = false;
      }
      
      function requestTick() {
        if (!ticking) {
          requestAnimationFrame(updateScrollEffects);
          ticking = true;
        }
      }
      
      // Parallax effect for background elements
      function updateParallax() {
        const scrolled = window.pageYOffset;
        const parallaxElements = document.querySelectorAll('.about-section::before, .team-section::before');
        
        parallaxElements.forEach(element => {
          const speed = 0.5;
          element.style.transform = `translateY(${scrolled * speed}px)`;
        });
      }
      
      // Mouse movement effects
      function handleMouseMove(e) {
        const mouseX = e.clientX / window.innerWidth;
        const mouseY = e.clientY / window.innerHeight;
        
        // Subtle parallax for team members
        const teamMembers = document.querySelectorAll('.team-member');
        teamMembers.forEach((member, index) => {
          const speed = (index + 1) * 0.02;
          const x = (mouseX - 0.5) * speed;
          const y = (mouseY - 0.5) * speed;
          
          member.style.transform = `translate(${x}px, ${y}px)`;
        });
      }
      
      // Initialize scroll effects
      window.addEventListener('scroll', requestTick);
      window.addEventListener('mousemove', handleMouseMove);
      
      // Initial animation trigger
      setTimeout(() => {
        updateScrollEffects();
      }, 100);
      
      // Add floating particles effect
      function createParticle() {
        const particle = document.createElement('div');
        particle.style.position = 'fixed';
        particle.style.width = '4px';
        particle.style.height = '4px';
        particle.style.background = 'rgba(102, 126, 234, 0.6)';
        particle.style.borderRadius = '50%';
        particle.style.pointerEvents = 'none';
        particle.style.zIndex = '1';
        particle.style.left = Math.random() * window.innerWidth + 'px';
        particle.style.top = window.innerHeight + 'px';
        
        document.body.appendChild(particle);
        
        const animation = particle.animate([
          { transform: 'translateY(0px) scale(1)', opacity: 1 },
          { transform: `translateY(-${window.innerHeight + 100}px) scale(0)`, opacity: 0 }
        ], {
          duration: Math.random() * 3000 + 2000,
          easing: 'linear'
        });
        
        animation.onfinish = () => {
          particle.remove();
        };
      }
      
      // Create particles periodically
      setInterval(createParticle, 300);
      
      // Modern team member interactions with crown effect
      document.addEventListener('DOMContentLoaded', function() {
        const teamMembers = document.querySelectorAll('.team-member');
        
        teamMembers.forEach((member, index) => {
          // Add stagger animation delay
          member.style.animationDelay = `${index * 0.1}s`;
          
          // Add smooth hover effects
          member.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-8px) scale(1.02)';
          });
          
          member.addEventListener('mouseleave', function() {
            this.style.transform = '';
          });
        });
        
        // Instructor Card Special Animation
        const instructorCard = document.querySelector('.instructor-card');
        
        if (instructorCard) {
          // Initial state
          instructorCard.style.opacity = '0';
          instructorCard.style.transform = 'translateY(50px) scale(0.9)';
          
          // Intersection Observer for scroll animation
          const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -100px 0px'
          };
          
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                instructorCard.style.transition = 'all 1s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                instructorCard.style.opacity = '1';
                instructorCard.style.transform = 'translateY(0) scale(1)';
              }
            });
          }, observerOptions);
          
          observer.observe(instructorCard);
          
          // Epic Golden Particle Explosion on Hover
          let particleInterval;
          instructorCard.addEventListener('mouseenter', function() {
            createGoldenExplosion(this);
            // Continuous particle stream while hovering
            particleInterval = setInterval(() => {
              createGoldenParticles(this);
            }, 400);
          });
          
          instructorCard.addEventListener('mouseleave', function() {
            clearInterval(particleInterval);
          });
          
          function createGoldenExplosion(element) {
            const rect = element.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            
            // Create burst of 20 particles
            for (let i = 0; i < 20; i++) {
              setTimeout(() => {
                const particle = document.createElement('div');
                const size = 8 + Math.random() * 8;
                particle.style.position = 'absolute';
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.background = `linear-gradient(135deg, #FFD700, #FFA500, #FF6B35)`;
                particle.style.borderRadius = '50%';
                particle.style.pointerEvents = 'none';
                particle.style.zIndex = '9999';
                particle.style.boxShadow = '0 0 20px rgba(255, 215, 0, 1)';
                
                particle.style.left = centerX + 'px';
                particle.style.top = centerY + 'px';
                
                document.body.appendChild(particle);
                
                const angle = (Math.PI * 2 * i) / 20;
                const distance = 150 + Math.random() * 100;
                const endX = centerX + Math.cos(angle) * distance;
                const endY = centerY + Math.sin(angle) * distance - 50;
                
                particle.animate([
                  {
                    left: centerX + 'px',
                    top: centerY + 'px',
                    opacity: 1,
                    transform: 'scale(0) rotate(0deg)'
                  },
                  {
                    left: endX + 'px',
                    top: endY + 'px',
                    opacity: 0,
                    transform: 'scale(2) rotate(720deg)'
                  }
                ], {
                  duration: 2000,
                  easing: 'cubic-bezier(0, 0.5, 0.5, 1)'
                }).onfinish = () => {
                  particle.remove();
                };
              }, i * 30);
            }
          }
          
          function createGoldenParticles(element) {
            const rect = element.getBoundingClientRect();
            const particle = document.createElement('div');
            particle.innerHTML = ['✨', '⭐', '💫', '🌟'][Math.floor(Math.random() * 4)];
            particle.style.position = 'absolute';
            particle.style.fontSize = (15 + Math.random() * 15) + 'px';
            particle.style.pointerEvents = 'none';
            particle.style.zIndex = '9999';
            particle.style.filter = 'drop-shadow(0 0 10px rgba(255, 215, 0, 0.8))';
            
            const startX = rect.left + Math.random() * rect.width;
            const startY = rect.bottom;
            
            particle.style.left = startX + 'px';
            particle.style.top = startY + 'px';
            
            document.body.appendChild(particle);
            
            particle.animate([
              { 
                top: startY + 'px',
                opacity: 1,
                transform: 'translateY(0) rotate(0deg) scale(0)'
              },
              { 
                top: (startY - 100 - Math.random() * 100) + 'px',
                opacity: 0,
                transform: `translateY(-50px) rotate(${Math.random() * 360}deg) scale(1.5)`
              }
            ], {
              duration: 2000 + Math.random() * 1000,
              easing: 'cubic-bezier(0, 0.5, 0.5, 1)'
            }).onfinish = () => {
              particle.remove();
            };
          }
          
          // EPIC Magical Aura Effect with Super Icons
          const instructorImage = instructorCard.querySelector('.instructor-image');
          if (instructorImage) {
            // Create super floating icons around instructor
            const icons = [
              { emoji: '👑', color: '#FFD700', size: '50px', trail: '✨' },
              { emoji: '🎓', color: '#4169E1', size: '45px', trail: '📚' },
              { emoji: '⚡', color: '#FFD700', size: '45px', trail: '💫' },
              { emoji: '🔥', color: '#FF4500', size: '45px', trail: '🌟' },
              { emoji: '💎', color: '#00CED1', size: '45px', trail: '✨' },
              { emoji: '🌟', color: '#FFD700', size: '40px', trail: '⭐' },
              { emoji: '🚀', color: '#FF6347', size: '40px', trail: '💨' },
              { emoji: '🏆', color: '#FFD700', size: '45px', trail: '🎉' }
            ];
            
            icons.forEach((iconData, index) => {
              const floatingIcon = document.createElement('div');
              floatingIcon.innerHTML = iconData.emoji;
              floatingIcon.style.position = 'absolute';
              floatingIcon.style.fontSize = iconData.size;
              floatingIcon.style.opacity = '0';
              floatingIcon.style.pointerEvents = 'none';
              floatingIcon.style.zIndex = '9998';
              floatingIcon.style.filter = `drop-shadow(0 0 25px ${iconData.color}) drop-shadow(0 0 45px ${iconData.color})`;
              floatingIcon.className = 'floating-instructor-icon';
              
              const angle = (Math.PI * 2 * index) / icons.length;
              const radius = 280;
              
              instructorCard.appendChild(floatingIcon);
              
              // Add trail effect
              const trail = document.createElement('div');
              trail.innerHTML = iconData.trail;
              trail.style.position = 'absolute';
              trail.style.fontSize = '20px';
              trail.style.opacity = '0';
              trail.style.pointerEvents = 'none';
              trail.style.zIndex = '9997';
              trail.className = 'floating-instructor-trail';
              instructorCard.appendChild(trail);
              
              instructorCard.addEventListener('mouseenter', () => {
                const rect = instructorImage.getBoundingClientRect();
                const cardRect = instructorCard.getBoundingClientRect();
                const centerX = rect.left - cardRect.left + rect.width / 2;
                const centerY = rect.top - cardRect.top + rect.height / 2;
                
                setTimeout(() => {
                  floatingIcon.style.left = (centerX + Math.cos(angle) * radius) + 'px';
                  floatingIcon.style.top = (centerY + Math.sin(angle) * radius) + 'px';
                  floatingIcon.style.opacity = '1';
                  floatingIcon.style.transition = 'all 1s cubic-bezier(0.34, 1.56, 0.64, 1)';
                  floatingIcon.style.animation = `superIconOrbit${index} 5s ease-in-out infinite`;
                  
                  trail.style.left = (centerX + Math.cos(angle) * (radius - 40)) + 'px';
                  trail.style.top = (centerY + Math.sin(angle) * (radius - 40)) + 'px';
                  trail.style.opacity = '0.7';
                  trail.style.transition = 'all 1s cubic-bezier(0.34, 1.56, 0.64, 1)';
                  trail.style.animation = `trailOrbit${index} 5s ease-in-out infinite`;
                }, index * 100);
              });
              
              instructorCard.addEventListener('mouseleave', () => {
                floatingIcon.style.opacity = '0';
                floatingIcon.style.animation = 'none';
                trail.style.opacity = '0';
                trail.style.animation = 'none';
              });
              
              // Add super orbit animation with bounce
              const style = document.createElement('style');
              style.textContent = `
                @keyframes superIconOrbit${index} {
                  0%, 100% {
                    transform: rotate(${angle}rad) translateX(${radius}px) rotate(-${angle}rad) scale(1);
                    filter: drop-shadow(0 0 25px ${iconData.color}) drop-shadow(0 0 45px ${iconData.color});
                  }
                  25% {
                    transform: rotate(${angle + Math.PI/2}rad) translateX(${radius + 30}px) rotate(-${angle + Math.PI/2}rad) scale(1.6);
                    filter: drop-shadow(0 0 35px ${iconData.color}) drop-shadow(0 0 65px ${iconData.color});
                  }
                  50% {
                    transform: rotate(${angle + Math.PI}rad) translateX(${radius}px) rotate(-${angle + Math.PI}rad) scale(1);
                    filter: drop-shadow(0 0 25px ${iconData.color}) drop-shadow(0 0 45px ${iconData.color});
                  }
                  75% {
                    transform: rotate(${angle + Math.PI * 1.5}rad) translateX(${radius + 30}px) rotate(-${angle + Math.PI * 1.5}rad) scale(1.6);
                    filter: drop-shadow(0 0 35px ${iconData.color}) drop-shadow(0 0 65px ${iconData.color});
                  }
                }
                
                @keyframes trailOrbit${index} {
                  0%, 100% {
                    transform: rotate(${angle}rad) translateX(${radius - 40}px) rotate(-${angle}rad) scale(0.8);
                    opacity: 0.5;
                  }
                  50% {
                    transform: rotate(${angle + Math.PI}rad) translateX(${radius - 40}px) rotate(-${angle + Math.PI}rad) scale(1.2);
                    opacity: 0.9;
                  }
                }
              `;
              document.head.appendChild(style);
            });
            
            // Add pulsing ring effect
            const ring = document.createElement('div');
            ring.style.position = 'absolute';
            ring.style.width = '500px';
            ring.style.height = '500px';
            ring.style.border = '3px solid rgba(255, 215, 0, 0.4)';
            ring.style.borderRadius = '50%';
            ring.style.opacity = '0';
            ring.style.pointerEvents = 'none';
            ring.style.zIndex = '9996';
            ring.style.transition = 'all 0.8s ease';
            instructorCard.appendChild(ring);
            
            instructorCard.addEventListener('mouseenter', () => {
              const rect = instructorImage.getBoundingClientRect();
              const cardRect = instructorCard.getBoundingClientRect();
              const centerX = rect.left - cardRect.left + rect.width / 2;
              const centerY = rect.top - cardRect.top + rect.height / 2;
              
              ring.style.left = (centerX - 250) + 'px';
              ring.style.top = (centerY - 250) + 'px';
              ring.style.opacity = '1';
              ring.style.animation = 'ringPulse 2s ease-in-out infinite';
            });
            
            instructorCard.addEventListener('mouseleave', () => {
              ring.style.opacity = '0';
              ring.style.animation = 'none';
            });
            
            const ringStyle = document.createElement('style');
            ringStyle.textContent = `
              @keyframes ringPulse {
                0%, 100% {
                  transform: scale(1) rotate(0deg);
                  border-color: rgba(255, 215, 0, 0.4);
                }
                50% {
                  transform: scale(1.1) rotate(180deg);
                  border-color: rgba(255, 165, 0, 0.8);
                }
              }
            `;
            document.head.appendChild(ringStyle);
          }
        }
      });
      
