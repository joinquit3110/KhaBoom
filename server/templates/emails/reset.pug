extends _template

block preheader
  | Reset your Kha-Boom! password 🔐

block body
  div(style="text-align:center;padding:20px 0;border-bottom:2px solid #f0f0f0;margin-bottom:30px")
    h1(style="font-size:28px;margin:0 0 10px 0;color:#1a1a2e;font-family:'Poppins',sans-serif") Password Reset Request 🔓
    p(style="color:#667eea;font-size:16px;margin:0") Let's get you back to learning!

  h2(style="font-size:20px;margin:30px 0 15px 0;color:#1a1a2e") Hi #{user.shortName},

  div(style="background:linear-gradient(135deg, rgba(240,147,251,0.1) 0%, rgba(245,87,108,0.1) 100%);padding:20px;border-radius:15px;margin:20px 0")
    p(style="color:#333;line-height:1.8;font-size:16px") 
      | We received a request to reset the password for your 
      strong(style="color:#f093fb") Kha-Boom!
      |  account. No worries – it happens to the best of us! 😊
    
    p(style="color:#666;line-height:1.6") Click the button below to create a new password:

  div(style="background:#fff;border:2px solid #f093fb;border-radius:15px;padding:25px;margin:30px 0;text-align:center")
    p(style="color:#1a1a2e;font-size:16px;margin-bottom:20px;font-weight:500") 🔑 Ready to reset your password?
    +button(`https://#{config.domain}/reset/${user.passwordResetToken}`, "Create New Password")
    
    p(style="color:#999;font-size:13px;margin-top:20px") 
      | Can't click the button? Copy this link:
      br
      span(style="color:#f093fb;font-size:12px;word-break:break-all") https://#{config.domain}/reset/#{user.passwordResetToken}

  div(style="background:rgba(239,68,68,0.1);border-left:4px solid #ef4444;padding:15px;border-radius:8px;margin:25px 0")
    p(style="color:#dc2626;font-weight:600;margin:0 0 5px 0;font-size:14px") ⚠️ Important Security Notice
    p(style="color:#666;font-size:14px;line-height:1.6;margin:5px 0") 
      | • This reset link expires in 
      strong 1 hour
      |  for your security
    p(style="color:#666;font-size:14px;line-height:1.6;margin:5px 0") 
      | • If you didn't request this reset, please ignore this email
    p(style="color:#666;font-size:14px;line-height:1.6;margin:5px 0") 
      | • Your password won't be changed until you create a new one

  div(style="margin-top:40px;padding-top:30px;border-top:2px solid #f0f0f0;text-align:center")
    p(style="color:#666;font-size:14px") 
      | Need help or didn't request this reset?
      br
      | Contact our support team immediately:
      br
      a(href="mailto:#{config.accounts.supportEmail}" style="color:#667eea;font-weight:500") #{config.accounts.supportEmail}
    
    p(style="color:#999;font-size:14px;margin-top:20px") Stay secure! 🔒
    p(style="color:#667eea;font-size:14px;margin:5px 0;font-weight:600") The Kha-Boom! Security Team
