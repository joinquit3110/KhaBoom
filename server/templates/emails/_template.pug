mixin button(url, text)
  p(style="text-align: center; margin: 40px 0")
    a(href=url style="display: inline-block; color: #FFFFFF; text-decoration: none; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 12px 32px; font-weight: 600; border-radius: 50px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px;")= text

doctype html
html
  head
    meta(http-equiv="Content-Type" content="text/html; charset=utf-8")
    meta(name="viewport" content="width=device-width")
    meta(http-equiv="X-UA-Compatible" content="IE=Edge")
    title Kha-Boom! Educational Platform
    style.
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500&display=swap');
      p{margin:0 0 16px 0;padding:0;font-family:'Inter',sans-serif}
      a{color:#667eea;text-decoration:none}
      h1,h2,h3{font-family:'Poppins',sans-serif;font-weight:600}

  body(style="margin:0px;padding:0px;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;background:linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%)")
    span.preheader(style="color:transparent;display:none;height:0;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;visibility:hidden;width:0;")
      block preheader

    table(cellpadding=0 cellspacing=0 border=0 width="100%")
      tr: td(style="background:linear-gradient(135deg, #0f0f23 0%, #1a1a2e 100%);padding:20px 0")
        table(width="100%" cellpadding=0 cellspacing=0 border=0 style="width:100%;max-width:600px;padding:0 20px;font-family:'Inter','Helvetica',arial,sans-serif;margin:0 auto" align="center")

          //- Header
          tr: td(align="center" style="padding:30px 0 20px 0;text-align:center")
            a(href="https://#{config.domain}" style="text-decoration:none")
              h1(style="margin:0;font-size:36px;font-weight:700;background:linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;color:#667eea;font-family:'Poppins',sans-serif") Kha-Boom!

          //- Body
          tr: td.body(style="background:rgba(255,255,255,0.95);border-radius:20px;box-shadow:0 8px 32px rgba(31,38,135,0.37);font-size:16px;line-height:24px;padding:35px 30px;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2)")
            block body

          tr: td(width="100%" style="color:rgba(255,255,255,0.8);font-size:12px;line-height:20px;padding:30px 0 40px 0;text-align:center;")
            p(style="margin:10px 0;color:rgba(255,255,255,0.6)") 
              a(href=config.privacyPolicy style="color:#667eea;margin:0 10px") Privacy Policy
              span(style="color:rgba(255,255,255,0.4)") •
              a(href=config.termsOfService style="color:#667eea;margin:0 10px") Terms of Service
            p(style="margin:10px 0;color:rgba(255,255,255,0.5)") This email was sent to #{user.fullName} at #{user.email}
            p(style="margin:10px 0;color:rgba(255,255,255,0.4)")= config.accounts.address
            p(style="margin:20px 0 0 0;color:rgba(255,255,255,0.6);font-weight:600") © 2024 Kha-Boom! Educational Platform
