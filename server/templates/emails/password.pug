extends _template

block preheader
  | Your Kha-Boom! password has been successfully changed ✅

block body
  div(style="text-align:center;padding:20px 0;border-bottom:2px solid #f0f0f0;margin-bottom:30px")
    h1(style="font-size:28px;margin:0 0 10px 0;color:#1a1a2e;font-family:'Poppins',sans-serif") Password Changed Successfully ✅
    p(style="color:#10b981;font-size:16px;margin:0;font-weight:500") Your account is now secured with a new password

  h2(style="font-size:20px;margin:30px 0 15px 0;color:#1a1a2e") Hi #{user.shortName},

  div(style="background:linear-gradient(135deg, rgba(16,185,129,0.1) 0%, rgba(5,150,105,0.1) 100%);padding:20px;border-radius:15px;margin:20px 0")
    p(style="color:#333;line-height:1.8;font-size:16px") 
      | Great news! The password for your 
      strong(style="color:#10b981") Kha-Boom!
      |  account has been successfully changed.
    
    div(style="background:#fff;padding:15px;border-radius:10px;margin:15px 0")
      p(style="color:#666;font-size:14px;margin:5px 0")
        strong(style="color:#1a1a2e") Account:
        |  #{user.email}
      p(style="color:#666;font-size:14px;margin:5px 0")
        strong(style="color:#1a1a2e") Changed at:
        |  #{new Date().toLocaleString()}

  div(style="background:#fff;border:2px solid #10b981;border-radius:15px;padding:20px;margin:25px 0;text-align:center")
    p(style="color:#1a1a2e;font-size:16px;margin-bottom:15px;font-weight:500") 🎉 You're all set!
    p(style="color:#666;font-size:14px;line-height:1.6") 
      | You can now log in to your account with your new password.
      br
      | Ready to continue your learning journey?
    
    div(style="margin-top:20px")
      +button(`https://${config.domain}/courses`, "Back to Learning")

  div(style="background:rgba(239,68,68,0.1);border-left:4px solid #ef4444;padding:15px;border-radius:8px;margin:25px 0")
    p(style="color:#dc2626;font-weight:600;margin:0 0 10px 0;font-size:14px") 🚨 Didn't make this change?
    p(style="color:#666;font-size:14px;line-height:1.6;margin:0") 
      | If you didn't change your password, your account may be compromised.
      br
      strong Please contact us immediately:
      br
      a(href="mailto:#{config.accounts.supportEmail}" style="color:#ef4444;font-weight:600;font-size:16px") #{config.accounts.supportEmail}

  div(style="margin-top:40px;padding:20px;background:linear-gradient(135deg, rgba(102,126,234,0.05) 0%, rgba(118,75,162,0.05) 100%);border-radius:15px;text-align:center")
    p(style="color:#667eea;font-size:14px;font-weight:600;margin:0 0 10px 0") 📝 Security Tips:
    ul(style="color:#666;font-size:13px;line-height:1.8;text-align:left;display:inline-block;margin:0;padding-left:20px")
      li Use a unique password for each account
      li Enable two-factor authentication when available
      li Never share your password with anyone
      li Update your password regularly

  div(style="margin-top:30px;padding-top:20px;border-top:2px solid #f0f0f0;text-align:center")
    p(style="color:#999;font-size:14px;margin:5px 0") Thank you for keeping your account secure! 🔐
    p(style="color:#667eea;font-size:14px;margin:5px 0;font-weight:600") The Kha-Boom! Team
