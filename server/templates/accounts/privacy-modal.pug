//- Force users to accept privacy policies if they signed in using oAuth
if user && !user.acceptedPolicies && req.path !== '/profile' && req.path !== config.accounts.privacyPolicy
  x-modal#privacy.open(style="max-width: 600px;")
    .glass-panel(style="padding: 2.5rem; border-radius: 20px;")
      .text-center(style="margin-bottom: 2rem;")
        .gradient-text(style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;")
          x-icon(name="lock" size=32 style="vertical-align: middle; margin-right: 0.5rem;")
          | #{__('Welcome to Kha-Boom!')}
      
      .glass-card(style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.2); padding: 1.5rem; margin-bottom: 2rem;")
        p(style="color: rgba(255, 255, 255, 0.9); line-height: 1.6; margin: 0;")
          | #{__('Please review our')} 
          a(href=config.accounts.privacyPolicy target="_blank" style="color: #667eea; text-decoration: none; font-weight: 600;") #{__('Privacy Policy')}
          |  #{__('and our')} 
          a(href=config.accounts.termsOfUse target="_blank" style="color: #f093fb; text-decoration: none; font-weight: 600;") #{__('Terms of Service')}
          | . #{__('Make sure you understand what personal data we collect, and how we use that data to personalise and improve our content.')}
      
      form(style="display: flex; flex-direction: column; gap: 1.5rem;")
        label(style="display: flex; align-items: flex-start; gap: 0.75rem; cursor: pointer; color: rgba(255, 255, 255, 0.9);")
          input(
            type="checkbox" 
            name="policies" 
            required 
            style="width: 20px; height: 20px; margin-top: 2px; cursor: pointer;"
          )
          span(style="flex: 1; line-height: 1.5;")
            | #{__('I\'ve understood and agree to Kha-Boom! Privacy Policy and Terms of Service.')}
        
        button.btn-gradient(type="submit" style="padding: 14px 32px; font-size: 1rem; width: 100%;")= __('Accept & Continue')
