  // Glossary Modal for Dashboard
  x-modal#glossary-search(data-display="flex")
    button.close: x-icon(name="close" size=44)
    .gloss-sidebar
      h2 #[x-icon(name="glossary" size=32)] #{__('Glossary')}
      .gloss-search
        x-icon(name="search" size=24)
        input(type="text" placeholder=__('Search…'))
      .gloss-list
    .gloss-body
      p.text-center= __('Select one of the keywords on the left…')

  script(type="application/json")#glossary!= JSON.stringify(glossaryData || {})
  
  script.
    // Initialize glossary functionality for dashboard
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const glossaryElement = document.getElementById('glossary');
        if (!glossaryElement) {
          console.warn('Glossary data element not found');
          return;
        }
        
        const glossary = JSON.parse(glossaryElement.textContent || '{}');
        console.log('Loaded glossary with', Object.keys(glossary).length, 'terms');
        
        const glossaryModal = document.getElementById('glossary-search');
        if (!glossaryModal) {
          console.warn('Glossary modal not found');
          return;
        }
        
        const glossBody = glossaryModal.querySelector('.gloss-body');
        const glossList = glossaryModal.querySelector('.gloss-list');
        const glossSearch = glossaryModal.querySelector('.gloss-search input');
        let activeItem = null;
        
        if (!glossBody || !glossList || !glossSearch) {
          console.warn('Glossary modal elements not found');
          return;
        }
        
        // Clear existing items
        glossList.innerHTML = '';
        
        // Populate glossary list 
        const sortedKeys = Object.keys(glossary).sort();
        glossList.innerHTML = '';
        
        sortedKeys.forEach(function(key) {
          const data = glossary[key];
          if (!data || !data.title) return;
          
          const item = document.createElement('div');
          item.className = 'gloss-item';
          item.innerHTML = data.title;
          item.tabIndex = 0;
          
          // Click handler
          item.addEventListener('click', function() {
            if (activeItem) activeItem.classList.remove('on');
            activeItem = item;
            item.classList.add('on');
            glossBody.innerHTML = data.text || 'No description available.';
          });
          
          glossList.appendChild(item);
          
          // Search functionality - matches sidebar.ts exactly
          const search = data.title.toLowerCase();
          function updateVisibility() {
            const searchValue = glossSearch.value.toLowerCase();
            const shouldHide = searchValue && search.indexOf(searchValue) < 0;
            item.classList.toggle('hidden', shouldHide);
          }
          
          glossSearch.addEventListener('input', updateVisibility);
        });
        
        console.log('Glossary initialized with', sortedKeys.length, 'terms');
        
      } catch (error) {
        console.error('Error initializing glossary:', error);
      }
    });